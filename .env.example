# ==============================================================================
# أمير ستور (Ameer Store) — قالب متغيرات البيئة الشامل (Environment Template)
# ==============================================================================
# انسخ هذا الملف إلى .env.local للتشغيل المحلي: cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. إعدادات المنصة الأساسية (Application Configuration)
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. بيانات الهوية والعلامة التجارية المعتمدة (Official Brand Identity)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BUSINESS_NAME="أمير ستور للعطور والعود الفاخر"
NEXT_PUBLIC_BRAND_NAME="AMIR STORE"
NEXT_PUBLIC_BUSINESS_SLOGAN="فخامة تدوم مع كل قطرة • أصالة التراث العربي"
NEXT_PUBLIC_BUSINESS_LOCATION="جمهورية مصر العربية"
NEXT_PUBLIC_BUSINESS_ADDRESS_PHRASE="شحن وتوصيل لكافة محافظات مصر مع حق المعاينة"
NEXT_PUBLIC_BUSINESS_PHONE="01220086002"
NEXT_PUBLIC_BUSINESS_WHATSAPP="01220086002"

# ------------------------------------------------------------------------------
# 3. الأمان والمصادقة (Authentication & Server Sessions)
# ------------------------------------------------------------------------------
# مفتاح سري عشوائي مشفر لا يقل عن 32 حرفاً لتوقيع جلسات المشرفين (HMAC-SHA256)
AUTH_SECRET=dev-secret-ameer-store-development-only-fallback-32chars

# البريد الإلكتروني المعتمد للمشرف (Admin) للوصول للوحة التحكم
ADMIN_EMAILS=yousseflabeeb256@gmail.com

# ------------------------------------------------------------------------------
# 4. قاعدة البيانات السحابية المجانية (Cloud Database — Neon / Vercel Postgres / Supabase)
# ------------------------------------------------------------------------------
# الباقة المجانية: 0.5 GiB تخزين مجاني دائم وسريع جداً على Neon أو Vercel Postgres.
# في حال عدم إدخال الرابط، سيعمل المتجر تلقائياً بنظام التخزين المحلي الذري (Atomic JSON Storage).
# بمجرد وضع الرابط، يتم إنشاء الجداول وفهارس الأداء وزرع العطور الملكية الثمانية تلقائياً.
#
# رابط الاتصال المجمع (Connection Pooling URL):
# POSTGRES_URL=postgres://default:your-password@ep-cool-fog-123456.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require
# DATABASE_URL=postgres://default:your-password@ep-cool-fog-123456.us-east-1.aws.neon.tech:5432/verceldb?sslmode=require

# ------------------------------------------------------------------------------
# 5. التخزين السحابي المجاني للصور (Media Storage — Cloudinary Free Tier)
# ------------------------------------------------------------------------------
# الباقة المجانية لـ Cloudinary:
# - 25 جيجابايت تخزين ونقل بيانات شهرياً مجاناً (25 Monthly Credits).
# - تحويل وضغط تلقائي للصور لأعلى جودة وأخف حجم (WebP/AVIF).
# - شبكة توزيع سحابية عالمية فائقة السرعة (Global CDN).
#
# طريقة التفعيل (خيار 1 — الرابط المباشر الكامل):
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#
# أو (خيار 2 — المفاتيح المنفصلة من لوحة تحكم Cloudinary):
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=your_api_secret_here

# ------------------------------------------------------------------------------
# 6. البريد الإلكتروني التلقائي المجاني (Transactional Emails — Resend Free Tier)
# ------------------------------------------------------------------------------
# الباقة المجانية لـ Resend:
# - 3,000 إيميل شهرياً مجاناً (100 إيميل/يومياً).
# - إرسال فواتير شراء ملكية بتصميم عربي فاخر (HTML Invoice).
# - إشعار فوري لبريد الإدارة عند كل طلب جديد.
#
# في حال عدم توفر المفتاح، يقوم السيرفر بمحاكاة الإرسال محلياً وتسجيل التفاصيل في الكونسول دون تعطيل الطلب.
# RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuv
#
# البريد المرسل (اختياري، الافتراضي هو onboarding@resend.dev الخاص بالتجارب):
# RESEND_FROM_EMAIL="Ameer Store <onboarding@resend.dev>"
